<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Add New Genre</h1>
    <div class="page-subtitle">Create a game genre tag for catalog categorization</div>
  </div>
  <div>
    <a href="/genres" class="btn">&larr; Back to Genres</a>
  </div>
</div>

<div class="form-container">
  <form action="/genres" method="POST">
    <div class="form-group">
      <label for="name">Genre Name *</label>
      <input 
        type="text" 
        id="name" 
        name="name" 
        class="form-control" 
        value="<%= genre.name || '' %>" 
        placeholder="e.g. Action RPG, Roguelike, Metroidvania" 
        required
      >
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea 
        id="description" 
        name="description" 
        class="form-control" 
        rows="3" 
        placeholder="Brief description of gameplay elements..."
      ><%= genre.description || '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Create Genre</button>
      <a href="/genres" class="btn">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
