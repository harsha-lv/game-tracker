<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Game Catalog</h1>
    <div class="page-subtitle">Master inventory of games, genres, and developers</div>
  </div>
  <div>
    <a href="/games/new" class="btn btn-primary">+ Add New Game</a>
  </div>
</div>

<% if (games.length === 0) { %>
  <div class="empty-state">
    <p>The catalog is currently empty.</p>
    <a href="/games/new" class="btn btn-primary">Add the First Game</a>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Release Year</th>
          <th>Genres</th>
          <th>Developers</th>
          <th>In Your Library?</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% games.forEach(game => { %>
          <tr>
            <td>
              <strong><a href="/games/<%= game.id %>"><%= game.title %></a></strong>
            </td>
            <td><%= game.release_year || '—' %></td>
            <td><%= game.genres_list || '—' %></td>
            <td><%= game.developers_list || '—' %></td>
            <td>
              <% if (game.user_status) { %>
                <span class="badge <%= game.user_status === 'Completed' ? 'badge-completed' : (game.user_status === 'Currently Playing' ? 'badge-playing' : 'badge-want') %>">
                  <%= game.user_status %>
                </span>
              <% } else { %>
                <span style="color: var(--text-muted); font-size: 12px;">Not in library</span>
              <% } %>
            </td>
            <td style="text-align: right; white-space: nowrap;">
              <a href="/games/<%= game.id %>" class="btn btn-sm">View</a>
              <a href="/games/<%= game.id %>/edit" class="btn btn-sm">Edit</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
