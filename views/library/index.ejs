<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">My Library</h1>
    <div class="page-subtitle">Track your playthrough progress, ratings, and gaming backlog</div>
  </div>
  <div>
    <a href="/games" class="btn">+ Browse Catalog to Add</a>
  </div>
</div>

<div class="filter-tabs">
  <a href="/library?status=all" class="filter-tab <%= currentStatus === 'all' ? 'active' : '' %>">
    All (<%= counts.total_count %>)
  </a>
  <a href="/library?status=Currently+Playing" class="filter-tab <%= currentStatus === 'Currently Playing' ? 'active' : '' %>">
    Currently Playing (<%= counts.playing_count %>)
  </a>
  <a href="/library?status=Want+to+Play" class="filter-tab <%= currentStatus === 'Want to Play' ? 'active' : '' %>">
    Want to Play (<%= counts.want_count %>)
  </a>
  <a href="/library?status=Completed" class="filter-tab <%= currentStatus === 'Completed' ? 'active' : '' %>">
    Completed (<%= counts.completed_count %>)
  </a>
  <a href="/library?status=On+Hold" class="filter-tab <%= currentStatus === 'On Hold' ? 'active' : '' %>">
    On Hold (<%= counts.hold_count %>)
  </a>
  <a href="/library?status=Dropped" class="filter-tab <%= currentStatus === 'Dropped' ? 'active' : '' %>">
    Dropped (<%= counts.dropped_count %>)
  </a>
</div>

<% if (trackedGames.length === 0) { %>
  <div class="empty-state">
    <p>No games found in this list.</p>
    <a href="/games" class="btn btn-primary">Browse Catalog</a>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Status</th>
          <th>Rating</th>
          <th>Time Played</th>
          <th>Genres</th>
          <th>Developer</th>
          <th>Notes</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% trackedGames.forEach(entry => { %>
          <tr>
            <td>
              <strong><a href="/games/<%= entry.game_id %>"><%= entry.title %></a></strong>
              <% if (entry.release_year) { %>
                <span style="color: var(--text-muted); font-size: 12px; margin-left: 4px;">(<%= entry.release_year %>)</span>
              <% } %>
            </td>
            <td>
              <% if (entry.status === 'Currently Playing') { %>
                <span class="badge badge-playing">Playing</span>
              <% } else if (entry.status === 'Want to Play') { %>
                <span class="badge badge-want">Want to Play</span>
              <% } else if (entry.status === 'Completed') { %>
                <span class="badge badge-completed">Completed</span>
              <% } else if (entry.status === 'Dropped') { %>
                <span class="badge badge-dropped">Dropped</span>
              <% } else { %>
                <span class="badge badge-hold"><%= entry.status %></span>
              <% } %>
            </td>
            <td>
              <%= entry.rating ? `${entry.rating} / 10` : '—' %>
            </td>
            <td>
              <%= entry.hours_played ? `${entry.hours_played} hrs` : '0 hrs' %>
            </td>
            <td>
              <%= entry.genres_list || '—' %>
            </td>
            <td>
              <%= entry.developers_list || '—' %>
            </td>
            <td style="max-width: 200px; color: var(--text-muted); font-size: 12px;">
              <%= entry.review_notes ? (entry.review_notes.length > 50 ? entry.review_notes.substring(0, 50) + '...' : entry.review_notes) : '—' %>
            </td>
            <td style="text-align: right; white-space: nowrap;">
              <a href="/library/<%= entry.user_game_id %>/edit" class="btn btn-sm">Edit</a>
              <form action="/library/<%= entry.user_game_id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Remove <%= entry.title %> from your library? (The game will remain in the catalog)');">
                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
