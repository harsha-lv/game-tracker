<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Update Library Entry: <%= entry.title %></h1>
    <div class="page-subtitle">Update your personal playthrough progress and review</div>
  </div>
  <div>
    <a href="/library" class="btn">&larr; Back to Library</a>
  </div>
</div>

<div class="form-container">
  <form action="/library/<%= entry.id %>" method="POST">
    <div class="form-group">
      <label for="status">Playthrough Status</label>
      <select id="status" name="status" class="form-control" required>
        <option value="Want to Play" <%= entry.status === 'Want to Play' ? 'selected' : '' %>>Want to Play</option>
        <option value="Currently Playing" <%= entry.status === 'Currently Playing' ? 'selected' : '' %>>Currently Playing</option>
        <option value="Completed" <%= entry.status === 'Completed' ? 'selected' : '' %>>Completed</option>
        <option value="On Hold" <%= entry.status === 'On Hold' ? 'selected' : '' %>>On Hold</option>
        <option value="Dropped" <%= entry.status === 'Dropped' ? 'selected' : '' %>>Dropped</option>
      </select>
    </div>

    <div class="form-group">
      <label for="rating">Personal Rating (1 to 10)</label>
      <input 
        type="number" 
        id="rating" 
        name="rating" 
        class="form-control" 
        min="1" 
        max="10" 
        step="1" 
        value="<%= entry.rating || '' %>" 
        placeholder="e.g. 9"
      >
      <div class="form-hint">Leave blank if unrated</div>
    </div>

    <div class="form-group">
      <label for="hours_played">Hours Played</label>
      <input 
        type="number" 
        id="hours_played" 
        name="hours_played" 
        class="form-control" 
        min="0" 
        step="0.5" 
        value="<%= entry.hours_played || 0 %>"
      >
    </div>

    <div class="form-group">
      <label for="review_notes">Playthrough Notes & Review</label>
      <textarea 
        id="review_notes" 
        name="review_notes" 
        class="form-control" 
        rows="4" 
        placeholder="Thoughts on combat, story, progression, completion date..."
      ><%= entry.review_notes || '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Changes</button>
      <a href="/library" class="btn">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
